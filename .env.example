# ── Général ─────────────────────────────────────────────────────────────
TZ=Etc/UTC
PUID=1000
PGID=1000

# Répertoire hôte partagé entre Riven (montage FUSE du débrideur) et Jellyfin
# (lecture seule) — voir ARCHITECTURE.md "Le piège du montage média". Doit être
# préparé une fois avant le premier démarrage (voir README §2) : le playbook
# Ansible le fait automatiquement, sinon `mkdir -p` + bind + rshared à la main.
MEDIA_DIR=./data/media

# Cache de transcodage Jellyfin — chemin hôte direct (bind mount, pas un volume
# Docker nommé) pour que scripts/jellyfin-disk-guard.py puisse le surveiller.
JELLYFIN_CACHE_DIR=./data/jellyfin-cache

# Cache disque RivenVFS — chemin hôte direct, pour scripts/riven-cache-cleanup.py.
RIVEN_CACHE_DIR=./data/riven-cache

# ── Ports publiés sur l'hôte ────────────────────────────────────────────
JELLYFIN_PORT=8096
RIVEN_PORT=8080
RIVEN_FRONTEND_PORT=3000
PROWLARR_PORT=9696
JELLYSEERR_PORT=5055

# ── Riven — secrets internes (jamais un compte externe) ────────────────
# Génère les deux avec :
#   openssl rand -hex 16      → RIVEN_BACKEND_API_KEY
#   openssl rand -base64 32   → RIVEN_AUTH_SECRET
# Stables une fois posés — ne pas régénérer après le premier déploiement (le
# frontend et le backend doivent continuer à s'accorder sur la même valeur).
RIVEN_BACKEND_API_KEY=
RIVEN_AUTH_SECRET=

# ── Débrideur — au moins UN des deux est obligatoire ─────────────────────
# Sans clé valide chez un débrideur premium, Riven scrape mais ne peut rien
# télécharger : rien n'apparaîtra jamais dans Jellyfin. Compte payant requis
# (~4€/mois chez les deux fournisseurs), pas d'alternative gratuite.
ALLDEBRID_ENABLED=true
ALLDEBRID_API_KEY=
REALDEBRID_ENABLED=false
REALDEBRID_API_KEY=

# Taille max du cache disque RivenVFS (Mo). Un film 4K pèse 20-50 Go — monte ce
# réglage si tu regardes beaucoup de contenu 4K pour réduire la fréquence
# d'éviction LRU pendant une lecture.
RIVEN_CACHE_MAX_SIZE_MB=8192

# Limite CPU du scraper Zilean (indexation DMM en continu, pas ponctuelle).
ZILEAN_CPU_LIMIT=2.0

# ── Rempli APRÈS le premier démarrage (voir README §3 "Mise en route") ──
# Prowlarr : Settings → General → API Key (http://localhost:9696 une fois lancé)
PROWLARR_API_KEY=
# Jellyfin : Dashboard → API Keys → créer une clé (http://localhost:8096)
JELLYFIN_API_KEY=
# Jellyseerr : Settings → General → API Key, format base64 (PAS celle de
# Settings → Jellyfin) (http://localhost:5055)
JELLYSEERR_ENABLED=true
JELLYSEERR_API_KEY=
