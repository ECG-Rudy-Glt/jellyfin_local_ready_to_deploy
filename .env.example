# ── Général ─────────────────────────────────────────────────────────────
TZ=Etc/UTC
# Utilisateur qui possède les fichiers (id -u / id -g sur l'hôte).
PUID=1000
PGID=1000

# Répertoire hôte partagé par tous les conteneurs, monté au même chemin (/data).
# CHEMIN ABSOLU obligatoire : il doit être rendu « shared » avant le premier
# démarrage (make init s'en charge). Voir ARCHITECTURE.md « Le piège du montage ».
DATA_DIR=/srv/media-stack/data
# Caches (transcodage Jellyfin, cache de lecture Decypharr). Chemin local, jamais sur le montage.
CACHE_DIR=/srv/media-stack/cache

# ── Débrideur (obligatoire) ─────────────────────────────────────────────
# alldebrid | realdebrid | torbox | premiumize | debridlink
DEBRID_PROVIDER=alldebrid
DEBRID_API_KEY=

# ── Ports publiés sur l'hôte ────────────────────────────────────────────
JELLYFIN_PORT=8096
SEERR_PORT=5055
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
BAZARR_PORT=6767
DECYPHARR_PORT=8282

# URL sous laquelle les clients joignent Jellyfin (annoncée en découverte réseau).
JELLYFIN_PUBLIC_URL=http://localhost:8096

# ── Options ─────────────────────────────────────────────────────────────
# Décommente pour lancer FlareSolverr avec le reste de la stack.
# COMPOSE_PROFILES=flaresolverr

# Épingle une version de Decypharr (projet jeune, changements fréquents), ex. v2.5
DECYPHARR_TAG=latest
