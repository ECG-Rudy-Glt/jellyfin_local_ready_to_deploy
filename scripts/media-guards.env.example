# Config partagée par tous les scripts de scripts/ — copié vers /etc/media-guards.env
# par le playbook Ansible (voir ansible/deploy-media-stack.yml), rempli à partir des
# mêmes valeurs que le .env principal une fois l'onboarding fait (voir README §3).
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
RIVEN_URL=http://localhost:8080
RIVEN_API_KEY=
MEDIA_DIR=/absolute/path/to/data/media
JELLYFIN_CACHE_DIR=/absolute/path/to/data/jellyfin-cache
RIVEN_CACHE_DIR=/absolute/path/to/data/riven-cache
